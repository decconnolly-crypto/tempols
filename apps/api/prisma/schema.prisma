generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Horizon {
  id          String      @id @default(cuid())
  title       String
  description String?
  targetTag   String
  horizonType String      @default("PROJECT") // 'PROJECT' | 'QUARTERLY'
  quarter     String?                          // '2026-Q4' — null for non-quarterly
  startDate   String?                          // 'YYYY-MM-DD'
  targetDate  String?                          // 'YYYY-MM-DD'
  keyResults  String      @default("[]")      // JSON array of strings
  status      String      @default("ACTIVE")  // 'ACTIVE' | 'COMPLETED' | 'ARCHIVED'
  tasks       Task[]
  milestones  Milestone[]
  createdAt   DateTime    @default(now())
}

model Milestone {
  id          String   @id @default(cuid())
  horizonId   String
  horizon     Horizon  @relation(fields: [horizonId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  String                          // 'YYYY-MM-DD'
  weekNumber  Int                             // 1..13 within the quarter
  isCompleted Boolean  @default(false)
  tasks       Task[]
  createdAt   DateTime @default(now())
}

model Habit {
  id                String   @id @default(cuid())
  title             String
  phase             String   // 'MORNING' | 'AFTERNOON' | 'EVENING'
  streak            Int      @default(0)
  durationMinutes   Int      @default(20)
  isCompletedToday  Boolean  @default(false)
  lastCompletedDate String?
  tasks             Task[]
  createdAt         DateTime @default(now())
}

model Task {
  id              String   @id @default(cuid())
  title           String
  description     String?
  phase           String   // 'MORNING' | 'AFTERNOON' | 'EVENING'
  durationMinutes Int      @default(30)
  isCompleted     Boolean  @default(false)
  provider        String   @default("MANUAL") // 'MANUAL' | 'GOOGLE' | 'KANEO'
  tags            String   @default("[]")    // JSON stringified array of tags
  scheduledDate   String   // Format: YYYY-MM-DD

  horizonId String?
  horizon   Horizon? @relation(fields: [horizonId], references: [id], onDelete: SetNull)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  habitId String?
  habit   Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
model Commitment {
  id                String   @id @default(cuid())
  title             String
  date              String   // 'YYYY-MM-DD' — the first occurrence for recurring, or the single date
  startTime         String   // 'HH:MM' in 24h format
  endTime           String?  // 'HH:MM' optional
  child             String?  // 'Aoife' | 'Cian' | null
  location          String?
  notes             String?
  recurrence        String   @default("NONE") // 'NONE' | 'WEEKLY' | 'FORTNIGHTLY' | 'MONTHLY'
  recurrenceEndDate String?  // 'YYYY-MM-DD' — optional end for recurring
  createdAt         DateTime @default(now())
}
model Recipe {
  id           String   @id @default(cuid())
  title        String
  category     String   // 'EASY' | 'PASTA' | 'WINTER' | 'WORLD' | 'FUN' | 'FAKEAWAY' | 'SUNDAY' | 'ANY'
  ingredients  String   @default("[]") // JSON array of strings (or legacy { name, quantity?, unit? })
  instructions String   @default("[]") // JSON array: [{ title?: string, text: string }]
  cookTime     Int      @default(30)   // minutes
  tags         String   @default("[]") // JSON array of strings
  notes        String?
  sourceUrl    String?
  sourceName   String?
  meals        Meal[]
  createdAt    DateTime @default(now())
}
model Meal {
  id        String   @id @default(cuid())
  date      String   // 'YYYY-MM-DD'
  mealType  String   @default("DINNER")
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([date, mealType])
}
model ShoppingListCache {
  id        String   @id @default(cuid())
  weekStart String   @unique
  data      String   @default("{}") // JSON: { sections: [{ aisle, items: [...] }] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShoppingListItem {
  id        String   @id @default(cuid())
  weekStart String
  name      String
  aisle     String
  createdAt DateTime @default(now())
}