                className={`text-xs font-medium px-3.5 py-1.5 rounded-full transition-colors cursor-pointer ${
                  selectedTags.includes(tag) ? 'bg-black text-white' : 'text-black/60 bg-gray-100 hover:bg-gray-200'
                }`}
              >
                #{tag}
              </button>
            ))}
          </div>
        </div>

        <button
          type="button"
